{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.akshayharti/ntfsmnt",
  "description": "Read-write NTFS on macOS via ntfs-3g. Reads free; mount/unmount/eject need expiring human approval.",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/AkshayHarti/ntfs-mounter",
    "source": "github"
  },
  "websiteUrl": "https://akshayharti.github.io/ntfs-mounter/",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "ntfsmnt",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "command",
          "value": "mcp"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "list_volumes",
        "get_status",
        "run_doctor",
        "request_grant",
        "mount_volume",
        "unmount_volume",
        "eject_volume",
        "list_grants",
        "revoke_grant"
      ],
      "notes": "recover and remove_hiberfile are never grantable and stay human-only."
    }
  }
}
